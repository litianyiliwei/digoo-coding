{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Verification Evidence",
  "type": "object",
  "required": [
    "change_id",
    "verdict",
    "source_revision",
    "revision_stable",
    "read_only",
    "acceptance_checks",
    "test_runs",
    "findings",
    "verifier_identity",
    "builder_identity"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "revision_stable": {
      "type": "boolean"
    },
    "read_only": {
      "type": "boolean"
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "PENDING",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "test_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "log": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "verifier_identity": {
      "type": "string",
      "minLength": 1
    },
    "builder_identity": {
      "type": "string",
      "minLength": 1
    },
    "layout_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "figma_node",
          "asserted_elements",
          "max_delta_px",
          "tolerance_px",
          "missing_elements",
          "result",
          "evidence"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^PAGE-\\d{3}$"
          },
          "figma_node": {
            "type": "string",
            "minLength": 1
          },
          "asserted_elements": {
            "type": "integer",
            "minimum": 1
          },
          "max_delta_px": {
            "type": "number",
            "minimum": 0
          },
          "tolerance_px": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "missing_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "PENDING",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "differences": {
            "type": "string"
          },
          "deviation_approved": {
            "type": "boolean"
          },
          "approved_by": {
            "type": "string"
          }
        }
      }
    }
  }
}