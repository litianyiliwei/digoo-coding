{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-spec.schema.json",
  "title": "Change Design Spec (design-spec.json)",
  "description": "几何规格层：只承载页面画板、区块布局与元素的视觉几何/状态引用，必须通过 pageId/blockId/elementId 引用 07 的权威清单，不复制页面名称、路由、角色、需求与 AC 等追踪字段。支持的关键字：type、required、properties、additionalProperties、items、enum、const、pattern、minItems、maxItems、minLength、minimum、maximum、$ref(#/$defs/...)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "meta", "pages"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourcePrototype", "prototypeVersion"],
      "properties": {
        "status": {
          "enum": ["DRAFT", "IN_REVIEW", "APPROVED"]
        },
        "sourcePrototype": {
          "type": "string",
          "minLength": 1
        },
        "prototypeVersion": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "tier": {
      "enum": ["must", "should", "free"]
    },
    "tieredNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "tieredPadding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0 }
        },
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "tieredSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "tokenRef": {
      "type": "string",
      "pattern": "^(token:[a-z0-9._-]+|none|N/A|PENDING)$"
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": { "enum": ["vertical", "horizontal", "none"] },
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "align": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": { "enum": ["start", "center", "end", "stretch"] },
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "$ref": "#/$defs/direction" },
        "gap": { "$ref": "#/$defs/tieredNumber" },
        "padding": { "$ref": "#/$defs/tieredPadding" },
        "width": { "$ref": "#/$defs/tieredNumber" },
        "height": { "$ref": "#/$defs/tieredNumber" },
        "align": { "$ref": "#/$defs/align" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "elementId": { "type": "string", "pattern": "^ELEM-" },
        "type": {
          "enum": ["text", "icon", "shape", "button", "input", "image", "chart", "map", "component", "divider", "other"]
        },
        "label": { "type": "string" },
        "size": { "$ref": "#/$defs/tieredSize" },
        "radius": { "$ref": "#/$defs/tieredNumber" },
        "fill": { "$ref": "#/$defs/tokenRef" },
        "textStyle": { "$ref": "#/$defs/tokenRef" },
        "icon": { "type": "string" },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "variant": { "type": "string" }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "order", "layout"],
      "properties": {
        "blockId": { "type": "string", "pattern": "^BLOCK-" },
        "order": { "type": "integer", "minimum": 1 },
        "layout": { "$ref": "#/$defs/layout" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "states": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "frame", "states", "blocks"],
      "properties": {
        "pageId": { "type": "string", "pattern": "^PAGE-" },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 1 },
            "height": { "type": "number", "minimum": 1 }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["none", "bottom-tab", "top-nav", "h5"] },
            "variant": { "type": "string" },
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
