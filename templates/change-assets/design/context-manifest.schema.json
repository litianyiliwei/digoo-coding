{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Context Manifest",
  "description": "Structure reference for openspec/changes/<change-id>/design/context-manifest.json generated by scripts/code-context.py before stage 08 implementation. It lists the required read set for the Change (owner and related module owned files, module cards, contracts, tests, integration paths, registries), the inputs deliberately excluded, and required inputs that could not be located. JSON is generated by scripts; never hand-write it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "capability",
    "generated_at",
    "read_set",
    "not_needed",
    "missing"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "description": "Primary capability slug registered in docs/product/capabilities.csv."
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "description": "Generation timestamp, ISO 8601."
    },
    "read_set": {
      "type": "array",
      "description": "Files or directories the implementer must read, with the reason each is in scope.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "category",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative file or directory path."
          },
          "category": {
            "enum": [
              "owned",
              "module-card",
              "contract",
              "test",
              "integration",
              "registry"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "not_needed": {
      "type": "array",
      "description": "Candidate inputs deliberately excluded from the read set, for example other modules' paths.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative file or directory path."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "description": "Required inputs that could not be located, for example a module card that does not exist yet.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "category",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative file or directory path."
          },
          "category": {
            "enum": [
              "owned",
              "module-card",
              "contract",
              "test",
              "integration",
              "registry"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
